FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/BluKube.Contracts/BluKube.Contracts.csproj src/BluKube.Contracts/
COPY src/BluKube.Client.Core/BluKube.Client.Core.csproj src/BluKube.Client.Core/
COPY src/BluKube.Tui.Rendering/BluKube.Tui.Rendering.csproj src/BluKube.Tui.Rendering/
COPY src/BluKube.Web/BluKube.Web.csproj src/BluKube.Web/
RUN dotnet restore src/BluKube.Web/BluKube.Web.csproj

COPY . .
RUN dotnet publish src/BluKube.Web/BluKube.Web.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

COPY --from=build /app/publish ./

ENV ASPNETCORE_URLS=http://0.0.0.0:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "BluKube.Web.dll"]
