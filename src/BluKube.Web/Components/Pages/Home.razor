@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable

@inject ClientShellService Client

@using BluKube.Web.Components.Native
@using BluKube.Web.Components.Terminal

@if (Client.State == ClientState.Loading)
{
    <div class="loading">Loading...</div>
}
else if (Client.State == ClientState.Login)
{
    <LoginView />
}
else
{
    <div class="client-page @Client.PageClass">
        <ClientHeader />

        @if (Client.View == ClientView.Terminal)
        {
            <TerminalHost />
        }
        else
        {
            <NativeClient />
        }
    </div>
}

@code {
    private DotNetObjectReference<Home>? _ref;

    protected override void OnInitialized()
    {
        Client.StateChanged += Refresh;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ref = DotNetObjectReference.Create(this);
            await Client.InitializeAsync();
            return;
        }

        await Client.StartPendingClientAsync(_ref);
    }

    [JSInvokable]
    public void OnXtermKey(string key, bool shift, bool ctrl, bool alt) =>
        Client.PostKey(key, shift, ctrl, alt);

    private void Refresh(object? sender, EventArgs args)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Client.StateChanged -= Refresh;
        _ref?.Dispose();
        await Client.StopAsync(resetSession: false);
    }
}
