@implements IDisposable
@inject NativeClientService Client

<section class="native-search">
    <form class="native-search-form" @onsubmit="Client.SearchAsync" @onsubmit:preventDefault>
        <input type="search" placeholder="Search YouTube" value="@_query" @oninput="UpdateQuery" />
        <button type="submit" disabled="@(!Client.CanSearch)">Search</button>
    </form>
    <div class="native-search-feedback">
        @if (Client.Error is not null)
        {
            <p class="error">@Client.Error</p>
        }
        else if (Client.BusyMessage is not null)
        {
            <div class="busy-row" role="status" aria-live="polite">
                <span class="busy-bars" aria-hidden="true"><span></span><span></span><span></span></span>
                <span>@Client.BusyMessage</span>
            </div>
        }
    </div>
</section>

@code {
    private string _query = string.Empty;

    protected override void OnInitialized()
    {
        Client.StateChanged += Client_StateChanged;
    }

    private void UpdateQuery(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? string.Empty;
        Client.SetQuery(_query);
    }

    private void Client_StateChanged(object? sender, EventArgs args)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Client.StateChanged -= Client_StateChanged;
    }
}
