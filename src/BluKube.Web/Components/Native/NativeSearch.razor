<section class="native-search">
    <form class="native-search-form" @onsubmit="Search" @onsubmit:preventDefault>
        <input type="search" placeholder="Search YouTube" value="@Query" @oninput="UpdateQuery" />
        <button type="submit" disabled="@(!CanSearch)">Search</button>
    </form>
    <div class="native-search-feedback">
        @if (Error is not null)
        {
            <p class="error">@Error</p>
        }
        else if (BusyMessage is not null)
        {
            <div class="busy-row" role="status" aria-live="polite">
                <span class="busy-bars" aria-hidden="true"><span></span><span></span><span></span></span>
                <span>@BusyMessage</span>
            </div>
        }
    </div>
</section>

@code {
    private bool _hasRendered;
    private string _lastRenderedQuery = string.Empty;
    private bool _lastRenderedCanSearch;
    private string? _lastRenderedError;
    private string? _lastRenderedBusyMessage;

    [Parameter] public string Query { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> QueryChanged { get; set; }
    [Parameter] public bool CanSearch { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? BusyMessage { get; set; }
    [Parameter] public EventCallback Search { get; set; }

    private Task UpdateQuery(ChangeEventArgs args) =>
        QueryChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);

    protected override bool ShouldRender()
    {
        var shouldRender = !_hasRendered
            || Query != _lastRenderedQuery
            || CanSearch != _lastRenderedCanSearch
            || Error != _lastRenderedError
            || BusyMessage != _lastRenderedBusyMessage;

        if (shouldRender)
        {
            _hasRendered = true;
            _lastRenderedQuery = Query;
            _lastRenderedCanSearch = CanSearch;
            _lastRenderedError = Error;
            _lastRenderedBusyMessage = BusyMessage;
        }

        return shouldRender;
    }
}
