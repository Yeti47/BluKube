@implements IDisposable

<main class="native-client">
    <div class="native-terminal">
        <NativeSearch Client="Client" />

        <NativePlayer Client="Client" />

        <NativeResults Client="Client" />
    </div>
</main>

@code {
    [Parameter, EditorRequired] public NativeClientService Client { get; set; } = default!;

    protected override void OnInitialized()
    {
        Client.StateChanged += RefreshAsync;
    }

    private Task RefreshAsync() =>
        InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Client.StateChanged -= RefreshAsync;
    }
}
