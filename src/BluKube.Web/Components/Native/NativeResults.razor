@if (Items.Count > 0)
{
    <section class="native-results" aria-label="Search results">
        @foreach (var item in Items)
        {
            <button type="button" class="result-row" @onclick="() => Play.InvokeAsync(item)" disabled="@Busy">
                <span>
                    <strong>@item.Title</strong>
                    <small>@item.Channel</small>
                </span>
                @if (IsLiveDuration(item.Duration))
                {
                    <span class="live-pill">LIVE</span>
                }
                else
                {
                    <span>@FormatTime(item.Duration)</span>
                }
            </button>
        }
    </section>
}

@code {
    private bool _hasRendered;
    private IReadOnlyList<MediaItem>? _lastRenderedItems;
    private bool _lastRenderedBusy;

    [Parameter] public IReadOnlyList<MediaItem> Items { get; set; } = [];
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<MediaItem> Play { get; set; }

    protected override bool ShouldRender()
    {
        var shouldRender = !_hasRendered
            || !ReferenceEquals(Items, _lastRenderedItems)
            || Busy != _lastRenderedBusy;

        if (shouldRender)
        {
            _hasRendered = true;
            _lastRenderedItems = Items;
            _lastRenderedBusy = Busy;
        }

        return shouldRender;
    }

    private static bool IsLiveDuration(TimeSpan duration) => duration <= TimeSpan.Zero;

    private static string FormatTime(TimeSpan time) =>
        time.TotalHours >= 1
            ? $"{(int)time.TotalHours}:{time.Minutes:D2}:{time.Seconds:D2}"
            : $"{time.Minutes}:{time.Seconds:D2}";
}
