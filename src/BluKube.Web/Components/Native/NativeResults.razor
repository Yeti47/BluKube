@implements IDisposable
@inject NativeClient Client

@if (Client.Results.Count > 0)
{
    <section class="native-results" aria-label="Search results">
        @foreach (var item in Client.Results)
        {
            <button type="button" class="result-row" @onclick="() => Client.PlayAsync(item)">
                <span>
                    <strong>@item.Title</strong>
                    <small>@item.Channel</small>
                </span>
                @if (IsLiveDuration(item.Duration))
                {
                    <span class="live-pill">LIVE</span>
                }
                else
                {
                    <span>@FormatTime(item.Duration)</span>
                }
            </button>
        }
    </section>
}

@code {
    protected override void OnInitialized()
    {
        Client.StateChanged += Client_StateChanged;
    }

    private void Client_StateChanged(object? sender, NativeClientChangedEventArgs args)
    {
        if (!args.Includes(NativeClientSection.Results))
            return;

        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Client.StateChanged -= Client_StateChanged;
    }

    private static bool IsLiveDuration(TimeSpan duration) => duration <= TimeSpan.Zero;

    private static string FormatTime(TimeSpan time) =>
        time.TotalHours >= 1
            ? $"{(int)time.TotalHours}:{time.Minutes:D2}:{time.Seconds:D2}"
            : $"{time.Minutes}:{time.Seconds:D2}";
}
