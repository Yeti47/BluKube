@inject ClientShell Client

<header class="client-header">
    <div class="brand-block">
        <AsciiLogo Class="brand-cube" />
        <div class="brand-copy">
            <strong>BluKube</strong>
            <span class="brand-meta">YouTube Audio Client</span>
        </div>
    </div>

    <div class="header-actions">
        <div class="view-toggle" role="tablist" aria-label="Client view">
            <button type="button" class="@(Client.IsNativeView ? "active" : string.Empty)" @onclick="Client.ShowNativeAsync">Web</button>
            <button type="button" class="@(Client.IsNativeView ? string.Empty : "active")" @onclick="Client.ShowTerminalAsync">Terminal</button>
        </div>
        <a class="download-link" href="@TuiRelease.LinuxX64DownloadUrl">Download TUI</a>
        <button class="logout-button" type="button" @onclick="Client.ClearConfigAsync" title="Clear saved server URL and token">Log out</button>
    </div>
</header>
