<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BluKube.Tui</RootNamespace>
    <AssemblyName>blukube</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.49.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BluKube.Contracts\BluKube.Contracts.csproj" />
    <ProjectReference Include="..\BluKube.Client.Core\BluKube.Client.Core.csproj" />
    <ProjectReference Include="..\BluKube.Tui.Rendering\BluKube.Tui.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="BluKube.Contracts" />
    <Using Include="BluKube.Client.Core" />
  </ItemGroup>

</Project>
