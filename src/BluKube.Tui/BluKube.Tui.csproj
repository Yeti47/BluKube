<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.2.0" />
    <PackageReference Include="NSwag.MSBuild" Version="14.5.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

  <PropertyGroup>
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
  </PropertyGroup>

  <Target Name="NSwag" AfterTargets="PostBuildEvent" Condition=" '$(DesignTimeBuild)' != 'true' And '$(BuildingProject)' == 'true' And Exists('$(ProjectDir)../BluKube.Server/obj/openapi.json') ">
    <Exec Command="$(NSwagExe_Net90) openapi2csclient /Input:../BluKube.Server/obj/openapi.json /Output:ApiClient/BluKubeClient.cs /Namespace:BluKube.Cli.ApiClient /GenerateClientInterfaces:true /InjectHttpClient:true /ExceptionClass:BluKubeApiException /ClassName:BluKubeClient /UseBaseUrl:false" />
  </Target>

</Project>
